# --- ShipSaving Legacy API (v1) ---  https://docs.shipsaving.com/v1
# Your API token from the ShipSaving account (sent as ?api_token=...).
SHIPSAVING_API_TOKEN=
SHIPSAVING_API_BASE=https://api.shipsaving.com
# Optional: limit rates to one carrier account (ShipSaving -> Carrier Accounts -> Token)
SHIPSAVING_CARRIER_TOKEN=
# Required: an existing warehouse name (ShipSaving -> Warehouses -> Name)
SHIPSAVING_WAREHOUSE_NAME=
# Label file format: pdf (default) or png
SHIPSAVING_LABEL_TYPE=pdf

# --- Admin ---
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# Default margin used until you save one in /admin
DEFAULT_MARGIN_PERCENT=15
DEFAULT_FLAT_FEE=0

# --- Database (MongoDB) ---
# Required on Vercel (its filesystem is read-only). Leave empty locally to use the JSON file in DATA_DIR.
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net  or  mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=shipbridge

# Local fallback when MONGODB_URI is empty: folder for the JSON data file
DATA_DIR=./data
